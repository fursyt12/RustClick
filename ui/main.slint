import { Palette } from "std-widgets.slint";
import { AppState, CandidateRow, CapabilityRow, DeviceRow, LogRow, MappingRow, ProcessRow, WindowRow } from "state.slint";
import { FlatButton, Pill, Theme } from "components/widgets.slint";
import { HomePage } from "home.slint";
import { LogPage } from "log.slint";
import { PickerPage } from "picker.slint";
import { SettingsPage } from "settings.slint";
import { SimulatorPage } from "simulator.slint";
import { TargetPrompt } from "target_prompt.slint";

export { AppState, CandidateRow, CapabilityRow, DeviceRow, LogRow, MappingRow, ProcessRow, WindowRow }

// Home is the only screen needed during a presentation; everything else is
// one click away in the top bar and returns with "Back".
component TopBar inherits HorizontalLayout {
    property <string> title: AppState.page == 1 ? "Event log"
        : AppState.page == 2 ? "Choose target"
        : AppState.page == 3 ? "Settings"
        : AppState.page == 4 ? "Simulator"
        : "RustClick";
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 4px;

    if AppState.page != 0: FlatButton {
        text: "← Back";
        clicked => {
            AppState.page = 0;
        }
    }
    Text {
        text: root.title;
        font-size: 17px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if AppState.page == 0 && AppState.simulation: VerticalLayout {
        alignment: center;
        padding-left: 6px;
        Pill {
            text: "Simulation";
            tint: Theme.info;
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    if AppState.page == 0 && AppState.simulation: FlatButton {
        text: "Simulator";
        clicked => {
            AppState.page = 4;
        }
    }
    if AppState.page == 0: FlatButton {
        text: "Log";
        clicked => {
            AppState.page = 1;
        }
    }
    if AppState.page == 0: FlatButton {
        text: "Settings";
        clicked => {
            AppState.page = 3;
        }
    }
}

export component AppWindow inherits Window {
    title: "RustClick";
    preferred-width: 560px;
    preferred-height: 680px;
    min-width: 460px;
    min-height: 520px;
    background: Palette.background;

    // Follows the system by default; tools such as the screenshots example
    // can force a scheme.
    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;

    VerticalLayout {
        TopBar { }

        if AppState.page == 0: HomePage {
            vertical-stretch: 1;
        }
        if AppState.page == 1: LogPage {
            vertical-stretch: 1;
        }
        if AppState.page == 2: PickerPage {
            vertical-stretch: 1;
        }
        if AppState.page == 3: SettingsPage {
            vertical-stretch: 1;
        }
        if AppState.page == 4 && AppState.simulation: SimulatorPage {
            vertical-stretch: 1;
        }
    }

    if AppState.prompt-visible: TargetPrompt {
        width: root.width;
        height: root.height;
    }
}
