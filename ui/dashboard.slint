import { Button } from "std-widgets.slint";
import { AppState } from "state.slint";
import { Banner, Card, Field, PageHeader, StatusDot, Theme } from "components/widgets.slint";

export component DashboardPage inherits VerticalLayout {
    spacing: 14px;

    PageHeader {
        title: "Dashboard";
        subtitle: AppState.status-text;

        VerticalLayout {
            alignment: center;
            Button {
                text: AppState.routing-requested ? "Stop Routing" : "Start Routing";
                primary: !AppState.routing-requested;
                enabled: AppState.routing-requested || AppState.can-start;
                clicked => {
                    if AppState.routing-requested {
                        AppState.stop-routing();
                    } else {
                        AppState.start-routing();
                    }
                }
            }
        }
    }

    if !AppState.routing-requested && !AppState.can-start: Text {
        text: "Start Routing is unavailable: " + AppState.start-blocked-reason;
        color: Theme.muted;
        wrap: word-wrap;
    }

    if AppState.simulation: Banner {
        text: "Simulation mode: routing decisions are made by the real routing engine, but actions are delivered only to mock windows. Nothing is sent to real applications.";
        tint: Theme.info;
    }

    GridLayout {
        spacing: 12px;

        Row {
            Card {
                title: "Routing";
                preferred-width: 1px;
                content-alignment: start;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        StatusDot {
                            tint: Theme.level-color(AppState.routing-level);
                        }
                    }
                    Text {
                        text: AppState.routing-label;
                        font-size: 16px;
                        font-weight: 600;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                Field {
                    label: "Input mode";
                    value: AppState.mode-label;
                }
            }

            Card {
                title: "Target";
                preferred-width: 1px;
                content-alignment: start;
                Text {
                    text: AppState.target-summary;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-color(AppState.target-level);
                    wrap: word-wrap;
                }
                Text {
                    text: AppState.target-detail;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        text: "Change target…";
                        clicked => {
                            AppState.request-target-change();
                        }
                    }
                }
            }
        }

        Row {
            Card {
                title: "Input devices";
                preferred-width: 1px;
                content-alignment: start;
                Text {
                    text: AppState.devices-summary;
                    wrap: word-wrap;
                }
                Field {
                    label: "Last received event";
                    value: AppState.last-event == "" ? "None yet" : AppState.last-event;
                }
            }

            Card {
                title: "Last routing result";
                preferred-width: 1px;
                content-alignment: start;
                Text {
                    text: AppState.last-result == "" ? "No events processed yet" : AppState.last-result;
                    color: Theme.text-color(AppState.last-result-level);
                    wrap: word-wrap;
                }
            }
        }
    }

    Card {
        title: AppState.warnings.length == 0 ? "Warnings and errors" : "Warnings and errors (" + AppState.warnings.length + ")";
        if AppState.warnings.length == 0: Text {
            text: "Nothing to report.";
            color: Theme.muted;
        }
        for warning in AppState.warnings: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                padding-top: 4px;
                alignment: start;
                StatusDot {
                    tint: Theme.warning;
                }
            }
            Text {
                text: warning;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}
