import { Button, ComboBox, ListView } from "std-widgets.slint";
import { AppState } from "state.slint";
import { Pill, Theme } from "components/widgets.slint";

// Input events, routing decisions and delivery outcomes, newest first.
export component LogPage inherits VerticalLayout {
    padding: 20px;
    padding-top: 4px;
    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;
        ComboBox {
            horizontal-stretch: 1;
            model: ["All entries", "Input events", "Routing decisions", "Targets, devices, system"];
            current-index <=> AppState.log-filter;
            selected => {
                AppState.set-log-filter(self.current-index);
            }
        }
        Button {
            text: "Clear";
            clicked => {
                AppState.clear-log();
            }
        }
    }

    if AppState.log.length == 0: Text {
        text: "Nothing logged yet.";
        color: Theme.muted;
    }

    ListView {
        vertical-stretch: 1;
        for row in AppState.log: HorizontalLayout {
            spacing: 8px;
            padding-top: 3px;
            padding-bottom: 3px;
            padding-right: 12px;
            Text {
                text: row.time;
                width: 84px;
                font-size: 12px;
                color: Theme.muted;
            }
            VerticalLayout {
                width: 66px;
                alignment: start;
                Pill {
                    text: row.category;
                    tint: Theme.category-color(row.category);
                }
            }
            Text {
                text: (row.device == "" ? "" : row.device + " · ") + row.message;
                horizontal-stretch: 1;
                font-size: 12px;
                wrap: word-wrap;
                color: Theme.text-color(row.severity);
            }
        }
    }
}
