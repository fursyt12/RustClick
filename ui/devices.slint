import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { AppState, DeviceRow } from "state.slint";
import { Card, PageHeader, Pill, StatusDot, Theme } from "components/widgets.slint";
import { Palette } from "std-widgets.slint";

component DeviceListItem inherits Rectangle {
    in property <DeviceRow> device;
    in property <bool> selected;
    callback clicked();
    height: 58px;
    border-radius: 6px;
    background: selected ? Palette.accent-background.transparentize(0.85) : touch.has-hover ? Palette.foreground.transparentize(0.95) : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            StatusDot {
                tint: !device.connected ? Theme.error : device.enabled ? Theme.success : Theme.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: device.name;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: (device.simulated ? "Simulated" : "Physical") + (device.connected ? "" : " · disconnected") + " · last activity " + device.last-activity + " · " + device.id;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
            }
        }
        CheckBox {
            text: "Enabled";
            checked: device.enabled;
            toggled => {
                AppState.set-device-enabled(device.id, self.checked);
            }
        }
    }
}

component TestPanel inherits Card {
    property <bool> has-device: AppState.selected-device >= 0 && AppState.selected-device < AppState.devices.length;
    property <DeviceRow> device: AppState.devices[AppState.selected-device];
    title: has-device ? "Test panel — " + device.name : "Test panel";

    if !has-device: Text {
        text: "Select a device to test it.";
        color: Theme.muted;
    }

    if has-device: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            padding-right: 12px;

            Text {
                text: device.details + " · buttons: " + device.buttons.length;
                color: Theme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 6px;
                name-edit := LineEdit {
                    placeholder-text: "New name";
                    horizontal-stretch: 1;
                    accepted(text) => {
                        AppState.rename-device(device.id, text);
                        self.text = "";
                    }
                }
                Button {
                    text: "Rename";
                    enabled: name-edit.text != "";
                    clicked => {
                        AppState.rename-device(device.id, name-edit.text);
                        name-edit.text = "";
                    }
                }
            }

            if device.simulated: HorizontalLayout {
                spacing: 6px;
                Button {
                    text: device.connected ? "Disconnect" : "Reconnect";
                    clicked => {
                        AppState.set-device-connected(device.id, !device.connected);
                    }
                }
                Button {
                    text: "Remove";
                    clicked => {
                        AppState.remove-device(device.id);
                    }
                }
            }

            Text {
                text: "Generate test events";
                font-weight: 600;
            }
            for button in device.buttons: HorizontalLayout {
                spacing: 6px;
                Text {
                    text: button;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Button {
                    text: "Click";
                    enabled: device.connected;
                    clicked => {
                        AppState.emit-event(device.id, button, 0);
                    }
                }
                Button {
                    text: "Press";
                    enabled: device.connected;
                    clicked => {
                        AppState.emit-event(device.id, button, 1);
                    }
                }
                Button {
                    text: "Release";
                    enabled: device.connected;
                    clicked => {
                        AppState.emit-event(device.id, button, 2);
                    }
                }
            }
            Button {
                text: "Resend last event (duplicate)";
                enabled: device.connected;
                clicked => {
                    AppState.replay-last-event(device.id);
                }
            }
            Text {
                text: "Events from disabled or disconnected devices reach the log but are rejected by the router.";
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}

component EventLog inherits Card {
    title: "Event log";

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "Input events and routing decisions are separate entries. Newest first.";
            color: Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        ComboBox {
            model: ["All entries", "Input events", "Routing decisions", "Targets, devices, system"];
            current-index <=> AppState.log-filter;
            selected => {
                AppState.set-log-filter(self.current-index);
            }
        }
        Button {
            text: "Clear";
            clicked => {
                AppState.clear-log();
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        padding-left: 4px;
        padding-right: 16px;
        Text {
            text: "Time";
            width: 88px;
            color: Theme.muted;
            font-size: 11px;
        }
        Text {
            text: "Kind";
            width: 70px;
            color: Theme.muted;
            font-size: 11px;
        }
        Text {
            text: "Device";
            width: 110px;
            color: Theme.muted;
            font-size: 11px;
        }
        Text {
            text: "Button";
            width: 90px;
            color: Theme.muted;
            font-size: 11px;
        }
        Text {
            text: "Details";
            horizontal-stretch: 1;
            color: Theme.muted;
            font-size: 11px;
        }
    }

    ListView {
        vertical-stretch: 1;
        min-height: 120px;
        for row in AppState.log: HorizontalLayout {
            height: 24px;
            spacing: 8px;
            padding-left: 4px;
            Text {
                text: row.time;
                width: 88px;
                vertical-alignment: center;
                color: Theme.muted;
                font-size: 12px;
            }
            VerticalLayout {
                alignment: center;
                width: 70px;
                Pill {
                    text: row.category;
                    tint: Theme.category-color(row.category);
                }
            }
            Text {
                text: row.device;
                width: 110px;
                vertical-alignment: center;
                overflow: elide;
                font-size: 12px;
            }
            Text {
                text: row.button;
                width: 90px;
                vertical-alignment: center;
                overflow: elide;
                font-size: 12px;
            }
            Text {
                text: row.message;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                font-size: 12px;
                color: Theme.text-color(row.severity);
            }
        }
    }
}

export component DevicesPage inherits VerticalLayout {
    spacing: 14px;

    PageHeader {
        title: "Input Devices";
        subtitle: AppState.simulation ? "Simulated remotes. Add several to test multi-device routing." : "Physical devices are never enabled automatically.";

        VerticalLayout {
            alignment: center;
            profile := ComboBox {
                enabled: AppState.simulation;
                model: ["Two-button clicker", "Clicker with hold actions", "Pointer remote"];
                current-index: 2;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Add mock device";
                enabled: AppState.simulation;
                clicked => {
                    AppState.add-mock-device(profile.current-index);
                    AppState.selected-device = AppState.devices.length;
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 3;
        min-height: 220px;

        Card {
            title: "Devices (" + AppState.devices.length + ")";
            horizontal-stretch: 3;
            if AppState.devices.length == 0: Text {
                text: AppState.simulation ? "No devices. Add a mock device to start testing." : "No physical devices detected.";
                color: Theme.muted;
            }
            ListView {
                vertical-stretch: 1;
                for device[i] in AppState.devices: DeviceListItem {
                    device: device;
                    selected: i == AppState.selected-device;
                    clicked => {
                        AppState.selected-device = i;
                    }
                }
            }
        }

        TestPanel {
            horizontal-stretch: 2;
            min-width: 280px;
        }
    }

    EventLog {
        vertical-stretch: 2;
    }
}
