import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { AppState, CapabilityRow, MappingRow } from "state.slint";
import { Divider, Pill, Section, Theme } from "components/widgets.slint";

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    min-height: 32px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 11px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    @children
}

component MappingEditor inherits HorizontalLayout {
    in property <MappingRow> mapping;
    spacing: 8px;
    height: 34px;

    Text {
        text: mapping.button;
        width: 110px;
        vertical-alignment: center;
        overflow: elide;
    }
    ComboBox {
        width: 190px;
        model: AppState.action-names;
        current-index: mapping.action-index;
        selected => {
            AppState.set-mapping(mapping.button, self.current-index, mapping.custom == "" ? mapping.button : mapping.custom);
        }
    }
    if mapping.action-index == AppState.custom-action-index: LineEdit {
        horizontal-stretch: 1;
        text: mapping.custom;
        placeholder-text: "Custom action name";
        accepted(text) => {
            AppState.set-mapping(mapping.button, AppState.custom-action-index, text);
        }
    }
    if mapping.action-index != AppState.custom-action-index: Rectangle {
        horizontal-stretch: 1;
    }
}

component CapabilityItem inherits VerticalLayout {
    in property <CapabilityRow> cap;
    in property <bool> first-in-section;
    spacing: 2px;

    if root.first-in-section: Text {
        text: cap.section;
        font-weight: 600;
    }
    HorizontalLayout {
        spacing: 8px;
        Pill {
            text: cap.status;
            tint: Theme.level-color(cap.level);
        }
        Text {
            text: cap.component;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    // Full-width so the wrapped height is computed against the page width.
    Text {
        text: cap.detail;
        font-size: 11px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

export component SettingsPage inherits VerticalLayout {
    property <bool> confirm-reset;

    sv := ScrollView {
        vertical-stretch: 1;
        // Sized from the fixed outer width rather than `visible-width`, which
        // depends on the scrollbar and would feed back into wrapped text height.
        content-width: sv.width - 16px;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: sv.width - 16px;
            padding: 20px;
            padding-top: 4px;
            spacing: 18px;

            Section {
                title: "INPUT";
                SettingRow {
                    label: "Input mode";
                    hint: AppState.native-available ? "Native mode uses your real remotes and windows." : "Native mode is unavailable: " + AppState.native-reason;
                    ComboBox {
                        width: 170px;
                        enabled: AppState.native-available || AppState.input-mode == 1;
                        model: ["Simulation", "Native"];
                        current-index <=> AppState.input-mode;
                        selected => {
                            AppState.set-input-mode(self.current-index);
                        }
                    }
                }
            }

            Divider { }

            Section {
                title: "TARGET";
                SettingRow {
                    label: "Selection mode";
                    hint: AppState.selection-mode == 0 ? "One specific window; if it closes, a window of the same app with the same title is used." : "Any window of the process; a restarted instance of the same executable is matched.";
                    ComboBox {
                        width: 170px;
                        model: ["Window", "Process"];
                        current-index <=> AppState.selection-mode;
                        selected => {
                            AppState.set-selection-mode(self.current-index);
                        }
                    }
                }
                SettingRow {
                    label: "Select automatically when only one presentation app is open";
                    CheckBox {
                        checked <=> AppState.auto-select-single;
                        toggled => {
                            AppState.set-auto-select-single(self.checked);
                        }
                    }
                }
                SettingRow {
                    label: "When the target disappears";
                    ComboBox {
                        width: 170px;
                        model: ["Rebind if unambiguous", "Always ask"];
                        current-index <=> AppState.target-lost-policy;
                        selected => {
                            AppState.set-target-lost-policy(self.current-index);
                        }
                    }
                }
                SettingRow {
                    label: "When another presentation app appears";
                    ComboBox {
                        width: 170px;
                        model: ["Keep current target", "Ask"];
                        current-index <=> AppState.multiple-policy;
                        selected => {
                            AppState.set-multiple-policy(self.current-index);
                        }
                    }
                }
                SettingRow {
                    label: "Change-target shortcut";
                    hint: AppState.shortcut-status;
                    shortcut-edit := LineEdit {
                        width: 130px;
                        text <=> AppState.shortcut;
                        placeholder-text: "Ctrl+Alt+T";
                        accepted(text) => {
                            AppState.set-shortcut(text);
                        }
                    }
                    Button {
                        text: "Save";
                        clicked => {
                            AppState.set-shortcut(shortcut-edit.text);
                        }
                    }
                }
            }

            Divider { }

            Section {
                title: "BUTTONS";
                Text {
                    text: "Applies to every remote that has the button. Unmapped buttons do nothing.";
                    font-size: 11px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                for mapping in AppState.mappings: MappingEditor {
                    mapping: mapping;
                }
            }

            Divider { }

            Section {
                title: "DIAGNOSTICS";
                SettingRow {
                    label: "Log file";
                    hint: AppState.log-file == "" ? "No log file" : AppState.log-file;
                    Button {
                        text: "Open folder";
                        enabled: AppState.log-file != "";
                        clicked => {
                            AppState.open-log-folder();
                        }
                    }
                }
                SettingRow {
                    label: "Console log level";
                    hint: "The log file always records debug details.";
                    ComboBox {
                        width: 130px;
                        model: ["Error", "Warning", "Info", "Debug", "Trace"];
                        current-index <=> AppState.log-level;
                        selected => {
                            AppState.set-log-level(self.current-index);
                        }
                    }
                }
                SettingRow {
                    label: "Configuration";
                    hint: AppState.config-path;
                    if !root.confirm-reset: Button {
                        text: "Reset…";
                        clicked => {
                            root.confirm-reset = true;
                        }
                    }
                    if root.confirm-reset: Button {
                        text: "Cancel";
                        clicked => {
                            root.confirm-reset = false;
                        }
                    }
                    if root.confirm-reset: Button {
                        text: "Reset to defaults";
                        primary: true;
                        clicked => {
                            root.confirm-reset = false;
                            AppState.reset-config();
                        }
                    }
                }
                Text {
                    text: AppState.environment;
                    font-weight: 600;
                }
                for cap[i] in AppState.capabilities: CapabilityItem {
                    cap: cap;
                    first-in-section: i == 0 || AppState.capabilities[i - 1].section != cap.section;
                }
            }

            Divider { }

            Section {
                title: "ABOUT";
                Text {
                    text: "RustClick " + AppState.version + " · GPL-3.0-only";
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    AboutSlint {
                        max-height: 140px;
                    }
                }
            }
        }
    }
}
