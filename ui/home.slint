import { Button, Switch } from "std-widgets.slint";
import { AppState, DeviceRow } from "state.slint";
import { Banner, BigButton, Section, StatusDot, Theme } from "components/widgets.slint";

component DeviceItem inherits HorizontalLayout {
    in property <DeviceRow> device;
    spacing: 10px;
    padding-top: 4px;
    padding-bottom: 4px;

    VerticalLayout {
        alignment: center;
        StatusDot {
            tint: !device.connected ? Theme.error : device.enabled ? Theme.success : Theme.muted;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        horizontal-stretch: 1;
        Text {
            text: device.name;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: !device.connected ? "Disconnected"
                : device.last-activity != "never" ? "Last press " + device.last-activity
                : device.simulated ? "Simulated" : "No press yet";
            font-size: 11px;
            color: Theme.muted;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;
        Switch {
            checked: device.enabled;
            accessible-label: "Enable " + device.name;
            toggled => {
                AppState.set-device-enabled(device.id, self.checked);
            }
        }
    }
}

// The main screen: what is targeted, start/stop, and which remotes are used.
export component HomePage inherits VerticalLayout {
    padding: 20px;
    padding-top: 4px;
    spacing: 22px;

    for warning in AppState.warnings: Banner {
        text: warning;
        tint: Theme.warning;
    }

    Section {
        title: "TARGET";
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: AppState.target-summary;
                    font-size: 16px;
                    font-weight: 600;
                    color: Theme.text-color(AppState.target-level);
                    wrap: word-wrap;
                }
                if AppState.target-detail != "": Text {
                    text: AppState.target-detail;
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Change…";
                    clicked => {
                        AppState.refresh-targets();
                        AppState.page = 2;
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            BigButton {
                text: AppState.routing-requested ? "Stop" : "Start";
                secondary: AppState.routing-requested;
                enabled: AppState.routing-requested || AppState.can-start;
                clicked => {
                    if AppState.routing-requested {
                        AppState.stop-routing();
                    } else {
                        AppState.start-routing();
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                StatusDot {
                    tint: Theme.level-color(AppState.routing-level);
                }
            }
            Text {
                text: !AppState.routing-requested && !AppState.can-start ? "Can't start: " + AppState.start-blocked-reason : AppState.routing-label;
                color: Theme.muted;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }

    Section {
        title: "REMOTES";
        if AppState.devices.length == 0: Text {
            text: AppState.simulation ? "No remotes. Add a mock remote in the Simulator." : "No Logitech remote found. Plug in its receiver or pair it over Bluetooth.";
            color: Theme.muted;
            wrap: word-wrap;
        }
        for device in AppState.devices: DeviceItem {
            device: device;
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }

    if AppState.last-event != "": VerticalLayout {
        spacing: 2px;
        Text {
            text: "Last: " + AppState.last-event;
            font-size: 12px;
            color: Theme.muted;
            overflow: elide;
        }
        Text {
            text: AppState.last-result;
            font-size: 12px;
            color: Theme.text-color(AppState.last-result-level);
            wrap: word-wrap;
        }
    }
}
