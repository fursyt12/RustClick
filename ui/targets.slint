import { Button, CheckBox, ComboBox, ListView } from "std-widgets.slint";
import { AppState, ProcessRow, WindowRow } from "state.slint";
import { Banner, Card, PageHeader, Pill, Theme } from "components/widgets.slint";
import { Palette } from "std-widgets.slint";

component ProcessItem inherits Rectangle {
    in property <ProcessRow> process;
    height: 52px;
    border-radius: 6px;
    background: process.selected ? Palette.accent-background.transparentize(0.85) : transparent;

    HorizontalLayout {
        padding: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: process.app-name;
                    font-weight: 600;
                    overflow: elide;
                }
                if process.eligible: Pill {
                    text: "Eligible";
                    tint: Theme.success;
                }
                if process.selected: Pill {
                    text: "Target";
                    tint: Theme.info;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: process.process-name + " · PID " + process.pid + " · " + process.window-count + (process.window-count == 1 ? " window · " : " windows · ") + process.executable;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Select";
                enabled: AppState.selection-mode == 1;
                clicked => {
                    AppState.select-process(process.key);
                }
            }
        }
        if AppState.simulation: VerticalLayout {
            alignment: center;
            Button {
                text: "New window";
                clicked => {
                    AppState.mock-open-window(process.key);
                }
            }
        }
        if AppState.simulation: VerticalLayout {
            alignment: center;
            Button {
                text: "Restart";
                clicked => {
                    AppState.mock-restart-process(process.key);
                }
            }
        }
        if AppState.simulation: VerticalLayout {
            alignment: center;
            Button {
                text: "Quit";
                clicked => {
                    AppState.mock-kill-process(process.key);
                }
            }
        }
    }
}

component WindowItem inherits Rectangle {
    in property <WindowRow> window;
    height: 52px;
    border-radius: 6px;
    background: window.selected ? Palette.accent-background.transparentize(0.85) : transparent;

    HorizontalLayout {
        padding: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: window.title;
                    font-weight: 600;
                    overflow: elide;
                }
                if window.selected: Pill {
                    text: "Target";
                    tint: Theme.info;
                }
                if !window.available: Pill {
                    text: "Hidden";
                    tint: Theme.warning;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: window.app-name + " · PID " + window.pid + " · window " + window.window-id + (window.received == "" ? "" : " · " + window.received);
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Select";
                enabled: window.available;
                clicked => {
                    AppState.select-window(window.key);
                }
            }
        }
        if AppState.simulation: VerticalLayout {
            alignment: center;
            Button {
                text: "Close";
                clicked => {
                    AppState.mock-close-window(window.key);
                }
            }
        }
    }
}

export component TargetsPage inherits VerticalLayout {
    spacing: 14px;

    PageHeader {
        title: "Target Application";
        subtitle: AppState.notifications-active ? "Target list updates automatically." : "Automatic updates are off. Use Refresh to update the list.";

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Selection mode";
                    vertical-alignment: center;
                }
                ComboBox {
                    model: ["Window", "Process"];
                    current-index <=> AppState.selection-mode;
                    selected => {
                        AppState.set-selection-mode(self.current-index);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Refresh";
                clicked => {
                    AppState.refresh-targets();
                }
            }
        }
    }

    Card {
        title: "Current target";
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: AppState.target-summary;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-color(AppState.target-level);
                    wrap: word-wrap;
                }
                Text {
                    text: AppState.target-detail;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Change target…";
                    clicked => {
                        AppState.request-target-change();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Clear";
                    clicked => {
                        AppState.clear-target();
                    }
                }
            }
        }
        Text {
            text: AppState.selection-mode == 0 ? "Window mode: input goes to one specific window. If it closes, RustClick waits for a window of the same application with the same title." : "Process mode: input goes to a window of the selected process. If the window closes, another window of the process is used; if the process exits, a restarted instance of the same executable is matched.";
            font-size: 11px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }

    if AppState.targets-error != "": Banner {
        text: AppState.targets-error;
        tint: Theme.error;
    }

    Card {
        title: "Running applications (" + AppState.processes.length + ")";
        vertical-stretch: 1;
        ListView {
            vertical-stretch: 1;
            min-height: 80px;
            for process in AppState.processes: ProcessItem {
                process: process;
            }
        }
    }

    Card {
        title: "Windows (" + AppState.windows.length + ")";
        vertical-stretch: 1;
        ListView {
            vertical-stretch: 1;
            min-height: 80px;
            for window in AppState.windows: WindowItem {
                window: window;
            }
        }
    }

    if AppState.simulation: Card {
        title: "Mock environment";
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "Launch";
                vertical-alignment: center;
            }
            Button {
                text: "PowerPoint";
                clicked => {
                    AppState.mock-launch(0);
                }
            }
            Button {
                text: "Acrobat";
                clicked => {
                    AppState.mock-launch(1);
                }
            }
            Button {
                text: "Text editor";
                clicked => {
                    AppState.mock-launch(2);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            CheckBox {
                text: "Lifecycle notifications";
                checked <=> AppState.mock-notifications;
                toggled => {
                    AppState.set-mock-notifications(self.checked);
                }
            }
        }
    }
}
