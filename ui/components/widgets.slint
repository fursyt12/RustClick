// Small reusable building blocks shared by all pages.

import { Palette } from "std-widgets.slint";

export global Theme {
    out property <color> success: #2f9e5a;
    out property <color> warning: #c7861a;
    out property <color> error: #d64545;
    out property <color> info: #3b82c4;
    out property <color> muted: Palette.foreground.transparentize(0.45);
    out property <color> hover: Palette.foreground.transparentize(0.94);
    out property <color> selected: Palette.accent-background.transparentize(0.86);
    out property <length> radius: 8px;

    // Severity levels as sent by the controller: 0 info, 1 success, 2 warning, 3 error.
    public pure function level-color(level: int) -> color {
        return level == 1 ? #2f9e5a : level == 2 ? #c7861a : level == 3 ? #d64545 : #3b82c4;
    }

    public pure function text-color(level: int) -> color {
        return level == 0 ? Palette.foreground : self.level-color(level);
    }

    public pure function category-color(category: string) -> color {
        return category == "Input" ? #3b82c4
            : category == "Routing" ? #8b5cf6
            : category == "Delivery" ? #2f9e5a
            : category == "Target" ? #0f9b9b
            : #7a7f87;
    }
}

// A titled group of content without a frame.
export component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;

    if root.title != "": Text {
        text: root.title;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: Theme.muted;
    }
    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Palette.border;
}

export component StatusDot inherits Rectangle {
    in property <color> tint: Theme.info;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tint;
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.info;
    height: 20px;
    border-radius: 10px;
    background: tint.transparentize(0.84);
    min-width: label.preferred-width + 16px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;

    label := Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.tint;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// A text-only button for toolbars.
export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: label.preferred-width + 20px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? transparent : touch.pressed ? Palette.foreground.transparentize(0.88) : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? Palette.foreground : Theme.muted;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The one prominent action of a page.
export component BigButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // Secondary style (e.g. "Stop" while running).
    in property <bool> secondary;
    callback clicked();
    width: 220px;
    height: 46px;
    border-radius: 23px;
    border-width: root.secondary && root.enabled ? 1px : 0px;
    border-color: Palette.border;
    background: !root.enabled ? Palette.foreground.transparentize(0.92)
        : root.secondary ? (touch.has-hover ? Theme.hover : transparent)
        : touch.pressed ? Palette.accent-background.darker(0.2)
        : touch.has-hover ? Palette.accent-background.darker(0.1)
        : Palette.accent-background;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 15px;
        font-weight: 600;
        color: !root.enabled ? Theme.muted : root.secondary ? Palette.foreground : Palette.accent-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.info;
    background: tint.transparentize(0.88);
    border-radius: 6px;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: root.tint;
        }
        Text {
            text: root.text;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
